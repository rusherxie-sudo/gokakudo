---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import ShareButton from "../../../components/ShareButton.astro";
import { dainiQuestions, dainiSubjects } from "../../../data/daini-questions";
import { breadcrumbSchema } from "../../../data/site";

const breadcrumbs = breadcrumbSchema([
  { name: "合格堂", path: "/" },
  { name: "資格一覧", path: "/exams/" },
  { name: "第二種衛生管理者", path: "/exams/daini-eisei-kanrisha/" },
]);
const commonQuestions = [
  { question: "第二種衛生管理者とは、どのような資格ですか？", answer: "常時50人以上の労働者を使用する事業場のうち、有害業務を行わない事業場で選任が必要になる衛生管理者の国家資格です。有害業務のある事業場では第一種衛生管理者免許を有する者からの選任が必要です。" },
  { question: "第二種衛生管理者試験は何問ですか？", answer: "五肢択一式の30問で、試験時間は3時間です。関係法令10問、労働衛生10問、労働生理10問で構成されます。" },
  { question: "合格基準は何点ですか？", answer: "総得点が60%以上であることに加え、科目・範囲ごとの得点がそれぞれ40%以上であることが必要です。総合点だけでは合格にならない点に注意が必要です。" },
  { question: "第一種衛生管理者との違いは何ですか？", answer: "第一種は有害業務を行う事業場でも選任できますが、第二種は有害業務のない事業場に限られます。業務内容や受験資格に応じて選択します。" },
];
const faqSchema = {
  "@type": "FAQPage",
  mainEntity: commonQuestions.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })),
};
---

<BaseLayout
  title="第二種衛生管理者とは？試験科目・合格基準・無料問題｜合格堂"
  description="第二種衛生管理者の試験科目（関係法令・労働衛生・労働生理の各10問）、30問の出題構成、合格基準、受験料を公式情報に基づいて整理。公表問題も無料で解けます。"
  structuredData={[breadcrumbs, faqSchema]}
>
  <Header />
  <main id="main">
    <div class="breadcrumb shell"><a href="/">ホーム</a><span>›</span><a href="/exams/">資格一覧</a><span>›</span><strong>第二種衛生管理者</strong></div>
    <section class="exam-hero shell">
      <div>
        <p class="eyebrow">国家資格 · 医療・衛生</p>
        <h1>第二種衛生管理者</h1>
        <p>有害業務のない事業場で選任できる衛生管理者の国家資格。関係法令、労働衛生、労働生理を、公表問題から効率よく身につけます。</p>
        <div class="hero-actions"><a class="button primary" href="/practice/?exam=daini-eisei-kanrisha">8問で実力を測る</a><a class="text-link" href="/exams/daini-eisei-kanrisha/questions/">全{dainiQuestions.length}問を見る →</a><ShareButton variant="link" label="この試験を共有" text="第二種衛生管理者を無料で学べる合格堂を見つけました。" /></div>
      </div>
      <dl class="exam-facts">
        <div><dt>公開中</dt><dd>{dainiQuestions.length}問</dd></div>
        <div><dt>公表問題</dt><dd>{dainiQuestions.length}問</dd></div>
        <div><dt>更新</dt><dd>2026年8月</dd></div>
      </dl>
    </section>

    <section class="exam-info-section">
      <div class="shell">
        <div class="section-heading exam-info-heading">
          <div><p class="eyebrow">受験前に確認</p><h2>試験日・費用・合格基準</h2></div>
          <p>試験日は会場ごとに異なり、空席状況も変わります。ここでは変わりにくい要点を整理し、最新状況は公式ページへつなぎます。</p>
        </div>
        <div class="exam-info-grid">
          <article><small>次回試験</small><strong>会場ごとに随時実施</strong><p>全国のセンター・東京試験場・大阪試験場などで複数日程があります。</p><a href="https://www.exam.or.jp/schedule/h_nittei502/" target="_blank" rel="noopener noreferrer">会場別の日程を見る ↗</a></article>
          <article><small>受験手数料</small><strong>8,800円</strong><p>学科試験・非課税。支払い後の変更や取消には条件があります。</p><a href="https://www.exam.or.jp/h_tesuryo/" target="_blank" rel="noopener noreferrer">公式の手数料を見る ↗</a></article>
          <article><small>出題形式</small><strong>五肢択一・30問</strong><p>関係法令10問、労働衛生10問、労働生理10問。試験時間は3時間です。</p><a href="https://www.exam.or.jp/faq/" target="_blank" rel="noopener noreferrer">申請の注意事項を見る ↗</a></article>
          <article><small>合格基準</small><strong>総合60% + 各40%</strong><p>総得点だけでなく、科目・範囲ごとの最低点を下回らないことが必要です。</p><a href="https://www.exam.or.jp/faq/" target="_blank" rel="noopener noreferrer">公式の合格基準を見る ↗</a></article>
        </div>
        <p class="verified-note">公益財団法人 安全衛生技術試験協会の公開情報をもとに、2026年8月26日確認。申込前に必ず公式の最新情報をご確認ください。</p>
      </div>
    </section>

    <section class="section shell two-column exam-body">
      <div>
        <p class="eyebrow">科目別に学ぶ</p>
        <h2>出題範囲と公開状況</h2>
        <p class="section-copy">令和8年4月公表（全30問・根拠つき解説付き）、令和7年10月公表、令和7年4月公表（各30問）を3科目で公開しています。年次別アーカイブは順次拡充します。</p>
      </div>
      <div class="subject-table">{dainiSubjects.map((subject) => <div class="subject-row"><div><strong>{subject.name}</strong><span class:list={["subject-status", { live: subject.status === "公開中" }]}>{subject.status}</span></div><b>{subject.count}問</b></div>)}</div>
    </section>

    <section class="source-policy shell">
      <div><p class="eyebrow">問題の出どころ</p><h2>ひとつの題庫で、出どころは明確に。</h2></div>
      <div><p>各問題には「公表問題」の区分と確認元を表示し、安全衛生技術試験協会の公表PDFで正答を照合しています。</p><a href="https://www.exam.or.jp/lckohyo/" target="_blank" rel="noopener noreferrer">公式の公表試験問題を見る ↗</a></div>
    </section>
    <section class="knowledge-guide shell" aria-labelledby="daini-common-questions">
      <div class="section-heading"><p class="eyebrow">よく確認される要点</p><h2 id="daini-common-questions">第二種衛生管理者の基本</h2></div>
      <div>{commonQuestions.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div>
      <p class="verified-note">試験制度は変更される場合があります。2026年8月26日時点の公式情報をもとに掲載しています。</p>
    </section>
  </main>
  <Footer />
</BaseLayout>
