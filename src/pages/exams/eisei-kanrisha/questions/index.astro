---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { latestOfficialQuestions, officialQuestionBatches, officialQuestions, predictionQuestions } from "../../../../data/questions";
import { kakomonnReviewBatches, totalReviewQuestions } from "../../../../data/question-imports";
import { breadcrumbSchema } from "../../../../data/site";

const breadcrumbs = breadcrumbSchema([
  { name: "合格堂", path: "/" },
  { name: "第一種衛生管理者", path: "/exams/eisei-kanrisha/" },
  { name: "問題一覧", path: "/exams/eisei-kanrisha/questions/" },
]);
---

<BaseLayout
  title="第一種衛生管理者の公表問題・無料予想問題一覧｜合格堂"
  description="第一種衛生管理者の令和8年4月公表問題44問と、一次資料を確認して独自作成した無料予想問題8問を科目別に掲載。正答と確認元を確認できます。"
  structuredData={breadcrumbs}
>
  <Header />
  <main id="main">
    <div class="breadcrumb shell"><a href="/">ホーム</a><span>›</span><a href="/exams/eisei-kanrisha/">第一種衛生管理者</a><span>›</span><strong>問題一覧</strong></div>
    <section class="list-hero shell">
      <p class="eyebrow">公表問題 + 合格堂オリジナル</p>
      <h1>第一種衛生管理者<br />無料問題</h1>
      <p>令和8年4月公表の全44問と、関係法令の予想問題8問を公開しています。今日の8問は、すべての問題から選ばれます。</p>
      <div class="hero-actions"><a class="button primary" href="/practice/">今日の8問を解く</a><a class="button soft" href="/practice/?mode=official">最新公表44問に挑戦</a></div>
    </section>

    <section class="question-index shell" id="question-list">
      <div class="index-head"><h2>令和8年4月公表</h2><span>{officialQuestions.length}問</span></div>
      <div class="question-links">
        {latestOfficialQuestions.map((question, index) => (
          <a href={`/exams/eisei-kanrisha/questions/${question.id}/`} data-mobile-extra={index >= 10 ? "" : undefined}>
            <span>問{String(question.number).padStart(2, "0")}</span>
            <div><strong>{question.prompt}</strong><small>{question.contentType} · 正答・確認元を掲載 · 詳細解説は確認中</small></div>
            <i>→</i>
          </a>
        ))}
      </div>
      {latestOfficialQuestions.length > 10 && <button class="mobile-show-more" type="button" data-show-all>残り{latestOfficialQuestions.length - 10}問を表示</button>}
      <div class="archive-heading"><p class="eyebrow">年度別アーカイブ</p><h2>公表時期から選ぶ</h2></div>
      <div class="session-grid">
        {officialQuestionBatches.map((batch) => (
          <a href={`/exams/eisei-kanrisha/questions/session/${batch.batchId}/`}><small>{batch.session}</small><strong>{batch.questions.length}問</strong><span>問題を見る →</span></a>
        ))}
      </div>
      <div class="index-head secondary-index"><h2>合格堂オリジナル予想問題</h2><span>{predictionQuestions.length}問</span></div>
      <div class="question-links">
        {predictionQuestions.map((question) => (
          <a href={`/exams/eisei-kanrisha/questions/${question.id}/`}>
            <span>予{String(question.number).padStart(2, "0")}</span>
            <div><strong>{question.prompt}</strong><small>{question.contentType} · {question.difficulty} · 解説・根拠資料つき</small></div>
            <i>→</i>
          </a>
        ))}
      </div>
    </section>
    <section class="ingestion-status shell">
      <div><p class="eyebrow">公表問題の収録状況</p><h2>最新1期・44問を収録<br />残り23期を順次追加</h2></div>
      <div><p>過去問ドットコムの年度別・単題ページから題目、選択肢、正答を収録します。第三者が作成した解説、コメント、評価数は収録しません。</p><strong>対象総数：{kakomonnReviewBatches.length}期・{totalReviewQuestions.toLocaleString("ja-JP")}問</strong><a href={kakomonnReviewBatches[0].discoveryUrl} target="_blank" rel="noopener noreferrer">今回の確認元を見る ↗</a></div>
    </section>
  </main>
  <Footer />
  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-show-all]").forEach((button) => button.addEventListener("click", () => {
      button.previousElementSibling?.classList.add("show-all");
      button.remove();
    }));
  </script>
</BaseLayout>
