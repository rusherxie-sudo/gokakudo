---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { exams } from "../../data/exams";
---

<BaseLayout title="衛生管理者の過去問・乙4の無料問題｜資格一覧｜合格堂" description="第一種・第二種衛生管理者の過去問（公表問題）と、危険物取扱者乙種4類（乙4）のオリジナル問題を無料で学べる資格一覧。合格堂なら登録なしで演習を始められ、学習記録と復習対象を資格ごとに管理できます。">
  <Header />
  <main id="main">
    <div class="breadcrumb shell"><a href="/">ホーム</a><span>›</span><strong>資格一覧</strong></div>
    <section class="catalog-hero shell"><p class="eyebrow">資格を選ぶ</p><h1>次に取る資格を、<br />今日の8問から。</h1><p>登録なしですぐに開始できます。学習記録と復習対象は、資格ごとに分けて保存します。</p></section>
    <section class="exam-catalog shell">
      {exams.map((exam) => (
        <a class:list={["exam-catalog-card", `accent-${exam.accent}`]} href={`/exams/${exam.slug}/`}>
          <div><small>{exam.category}</small><b>{exam.badge}</b></div>
          <h2>{exam.name}</h2><p>{exam.description}</p>
          <dl><div><dt>公開中</dt><dd>{exam.questionCount}問</dd></div><div><dt>本試験</dt><dd>{exam.examQuestionCount}問</dd></div></dl>
          <span>この資格を学ぶ →</span>
        </a>
      ))}
    </section>
  </main>
  <Footer />
</BaseLayout>
